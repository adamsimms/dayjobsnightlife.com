# HTML keeps the Pages default: revalidate on each visit.
# Images, fonts, and the stylesheet stay cached.
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/site.css
  Cache-Control: public, max-age=31536000, immutable
