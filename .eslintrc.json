{
  "env": {
    "browser": true,
    "jquery": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["gulpfile.js"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["assets/scripts/customizer.js"],
      "globals": {
        "wp": "readonly"
      }
    }
  ]
}
